# Copy to .env.local (dev) or set in your hosting provider (production).

# Where demo-request submissions are POSTed (Slack incoming webhook, Zapier, Make, CRM...).
# REQUIRED in production — without it the demo form returns 503 instead of silently losing leads.
DEMO_WEBHOOK_URL=

# Where "which channel next?" votes are POSTed. REQUIRED in production.
CHANNEL_WEBHOOK_URL=

# Optional: signs every webhook with X-Infera-Signature: t=<unix>,v1=<HMAC-SHA256 hex of "t.body">.
WEBHOOK_SIGNING_SECRET=

# Optional but recommended when running >1 instance / serverless: shared rate limiting via Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: extra origins allowed to POST to /api/* (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=

# Optional: enables "Cloud AI" in the app (Claude for answers, collection plans and custom extraction).
# Without it, the app's on-device engine handles everything. Users still have to switch Cloud AI on in Settings.
ANTHROPIC_API_KEY=

# --- Channel connections (all optional) ---
# Telegram account sync (users link their account by scanning a QR code in the console).
# These are the SERVER's Telegram app credentials — one pair for every workspace. Users never see or
# enter them, and per-channel api_id / api_hash are not accepted.
#   1. Sign in at https://my.telegram.org/apps with any Telegram account (yours or the company's).
#   2. Create an app (any title/short name; platform "Desktop" or "Other"), then copy App api_id and App api_hash.
#   3. Paste them below (in .env.local for development), then restart the server (`next dev` / `npm start`).
# Keep api_hash secret. Without both values the Telegram option shows "Telegram isn't set up on this server yet".
# Full steps: docs/CONNECTORS_SETUP.md
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Gmail "Sign in with Google": OAuth client (Web application) in Google Cloud with the Gmail API enabled.
# Authorised redirect URI: ${APP_URL}/api/oauth/google/callback. Without it, mailboxes connect with an app password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta Graph API version for Messenger / Instagram (default v21.0).
META_GRAPH_VERSION=

# Single-user mode: no login or signup screens — opening the app signs in as the workspace owner.
# On by default in development; in production it stays off unless set to 1. Anyone who can reach the
# server gets full access, so only enable it in production behind a private network / VPN / auth proxy.
INFERA_AUTO_LOGIN=
# Optional: which existing account to sign in as (default: the first workspace owner).
INFERA_AUTO_LOGIN_EMAIL=
